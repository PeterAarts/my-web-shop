MONGODB_URI=mongodb://localhost:27017/my-custom-shop
PORT=3000
## Listen address. 127.0.0.1 = this machine only (Apache in front); 0.0.0.0 = whole network
HOST=127.0.0.1
## At least 32 random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
## In production the server refuses to start without it.
JWT_SECRET=

## development | production   (production: API docs off, strict CORS, secrets required)
NODE_ENV=development

## Extra websites that may call the API from a browser, comma-separated.
## Not needed when the shop and admin call /api on their own address (the normal setup).
CORS_ORIGINS=

## Where the server stores files it writes (default: inside the server folder).
## On the server, point these to the data folder so they are backed up and survive deploys.
UPLOAD_DIR=
LABELS_DIR=
PICKLIST_DIR=

## true = show the API documentation at /api-docs also in production (default: off)
ENABLE_API_DOCS=
## true = also send picklists to the printer (Windows only, needs: npm install pdf-to-printer)
PRINT_PICKLISTS=

# Default Admin User Credentials
# Only used once, when no admin exists yet. Remove the password from .env after the first start.
ADMIN_USERNAME= ##name ##
ADMIN_EMAIL= ## email address ##
ADMIN_PASSWORD= ## your secret password ##

# shipping
# Sender Address Details
SENDER_NAME=" ## your shop name for postal address"
SENDER_STREET=" ## your postal address "
SENDER_ZIPCODE=" ## your postal code"
SENDER_CITY=" ## city"
SENDER_COUNTRY_CODE=" ## 2 letter countrycode"

## SHIPPING PROVIDERS
# PostNL API Key
# This is a placeholder key. Replace it with your actual PostNL API key.
POSTNL_API_KEY= ## your postNL api key

## PAYMENT PROVIDERS
# STRIPE
PAYMENT_PROVIDER_STRIPE_PUBLISHABLE_KEY=## your keys
PAYMENT_PROVIDER_STRIPE_SECRET_KEY=s## your keys
PAYMENT_PROVIDER_STRIPE_SECRET=## your keys

# PAYPAL
# These are placeholder values. Replace them with your actual PayPal client ID and secret.
PAYMENT_PROVIDER_PAYPAL_CLIENT_ID=AXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYMENT_PROVIDER_PAYPAL_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX


## EMAIL configuration
# These are placeholder values. Replace them with your actual email configuration. I used mailtrap.io check online for options if you haven't selected one
EMAIL_HOST=##
EMAIL_PORT=##
EMAIL_USERNAME=##
EMAIL_PASSWORD=##
EMAIL_FROM_NAME="##"
EMAIL_FROM_ADDRESS="##"

# the url of the webshop (not of the adminsite), used in links in emails
VUE_APP_URL="http://localhost:5174"  ## production: https://rippelspaperlover.com
